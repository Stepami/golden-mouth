<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <IsTestProject>true</IsTestProject>
    </PropertyGroup>

    <ItemGroup>
        <Using Include="Reki.Tests.Generated"/>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\src\Reki.Api\Reki.Api.csproj"/>
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="TUnit"/>
        <PackageReference Include="TUnit.AspNetCore"/>
        <PackageReference Include="Testcontainers"/>
        <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing"/>
        <PackageReference Include="Microsoft.Extensions.Diagnostics.Testing"/>
        <PackageReference Include="NSubstitute"/>
        <PackageReference Include="WireMock.Net"/>
        <PackageReference Include="WebMotions.Fake.Authentication.JwtBearer"/>
    </ItemGroup>

    <ItemGroup>
        <Compile Remove="Generated\RekiApiClient.g.cs"/>
    </ItemGroup>

    <Target Name="GenerateApiClient" BeforeTargets="CoreCompile">
        <Exec WorkingDirectory="$(MSBuildProjectDirectory)\..\..\src\Reki.Api"
              Command="dotnet tool run nswag run nswag.json /variables:Configuration=$(Configuration)"/>
        <ItemGroup>
            <Compile Include="Generated\RekiApiClient.g.cs"/>
        </ItemGroup>
    </Target>
</Project>
