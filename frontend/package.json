    "react-dom": "19.3.0",
    "valibot": "1.5.0"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "typescript": "7.0.2",
    "vite": "8.3.1",
    "vite-plugin-telegram-mini-app": "0.3.1"
  }
