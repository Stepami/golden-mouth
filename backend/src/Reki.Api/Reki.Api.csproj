<Project Sdk="Microsoft.NET.Sdk.Web">
    <PropertyGroup>
        <OpenApiGenerateDocuments>true</OpenApiGenerateDocuments>
        <OpenApiGenerateDocumentsOnBuild>true</OpenApiGenerateDocumentsOnBuild>
        <OpenApiDocumentsDirectory>$(MSBuildProjectDirectory)\OpenApi</OpenApiDocumentsDirectory>
        <OpenApiGenerateDocumentsOptions>--file-name reki-api</OpenApiGenerateDocumentsOptions>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\Reki.Application\Reki.Application.csproj"/>
        <ProjectReference Include="..\Reki.Infrastructure\Reki.Infrastructure.csproj"/>
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.AspNetCore.OpenApi"/>
        <PackageReference Include="OpenIddict.AspNetCore"/>
        <PackageReference Include="Microsoft.Extensions.ApiDescription.Server" PrivateAssets="all"/>
        <PackageReference Include="Riok.Mapperly" PrivateAssets="all"/>
        <PackageReference Include="Serilog.AspNetCore"/>
        <PackageReference Include="Swashbuckle.AspNetCore.SwaggerUI"/>
        <PackageReference Include="Telegram.Bot"/>
    </ItemGroup>

    <ItemGroup>
        <Content Include="..\..\..\docs\config\balance.json"
                 Link="config\balance.json"
                 CopyToOutputDirectory="PreserveNewest"
                 CopyToPublishDirectory="PreserveNewest"/>
    </ItemGroup>
    <ItemGroup>
        <InternalsVisibleTo Include="Reki.Tests"/>
    </ItemGroup>
    <Target Name="GenerateFrontendApiClient"
            AfterTargets="GenerateOpenApiDocuments">
        <Exec WorkingDirectory="$(MSBuildProjectDirectory)/../.."
              Command="dotnet tool run nswag run ../frontend/nswag.frontend.json"/>
    </Target>
</Project>
