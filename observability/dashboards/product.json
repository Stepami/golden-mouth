          {
            "id": "p4",
            "type": "table",
            "title": "Возврат D1",
            "description": "Сколько игроков из дня вернулись на следующий день. Знаменатель это DAU того дня.",
            "queryType": "sql",
            "config": {
              "show_legends": false
            },
            "queries": [
              {
                "query": "SELECT to_timestamp_micros(a.day_index * 86400000000) AS day,\n       count(DISTINCT a.player_id) AS dau,\n       count(DISTINCT b.player_id) AS returned_d1\nFROM (SELECT DISTINCT player_id, floor(_timestamp / 86400000000) AS day_index FROM \"product\" WHERE activity_kind = 'real') a\nLEFT JOIN (SELECT DISTINCT player_id, floor(_timestamp / 86400000000) AS day_index FROM \"product\" WHERE activity_kind = 'real') b\n  ON b.player_id = a.player_id AND b.day_index = a.day_index + 1\nGROUP BY a.day_index ORDER BY a.day_index",
                "customQuery": true,
                "vrlFunctionQuery": "",
                "fields": {
                  "stream": "product",
                  "stream_type": "logs",
                  "x": [
                    {
                      "label": "day",
                      "alias": "day",
                      "column": "day",
                      "type": "build"
                    }
                  ],
                  "y": [
                    {
                      "label": "dau",
                      "alias": "dau",
                      "column": "dau",
                      "type": "build"
                    },
                    {
                      "label": "returned_d1",
                      "alias": "returned_d1",
                      "column": "returned_d1",
                      "type": "build"
                    }
                  ],
                  "filter": {
                    "filterType": "group",
                    "logicalOperator": "AND",
                    "conditions": []
                  }
                },
                "config": {
                  "query_label": "A",
                  "promql_legend": ""
                }
              }
            ],
            "layout": {
              "x": 96,
              "y": 8,
              "w": 96,
              "h": 8,
              "i": 4
            }
          },
          {
            "id": "p9",
            "type": "line",
            "title": "Churn D1",
            "description": "Churn = 100% - возврат D1. churned это игроки дня, не пришедшие на следующий.",
            "queryType": "sql",
            "config": {
              "show_legends": true
            },
            "queries": [
              {
                "query": "SELECT to_timestamp_micros(a.day_index * 86400000000) AS day,\n       count(DISTINCT a.player_id) AS dau,\n       count(DISTINCT b.player_id) AS returned_d1,\n       count(DISTINCT a.player_id) - count(DISTINCT b.player_id) AS churned,\n       round(100.0 * (count(DISTINCT a.player_id) - count(DISTINCT b.player_id)) / count(DISTINCT a.player_id), 1) AS churn_pct\nFROM (SELECT DISTINCT player_id, floor(_timestamp / 86400000000) AS day_index FROM \"product\" WHERE activity_kind = 'real') a\nLEFT JOIN (SELECT DISTINCT player_id, floor(_timestamp / 86400000000) AS day_index FROM \"product\" WHERE activity_kind = 'real') b\n  ON b.player_id = a.player_id AND b.day_index = a.day_index + 1\nGROUP BY a.day_index ORDER BY a.day_index",
                "customQuery": true,
                "vrlFunctionQuery": "",
                "fields": {
                  "stream": "product",
                  "stream_type": "logs",
                  "x": [
