<Project>
    <PropertyGroup>
        <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
        <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
        <!--Versions-->
        <MediatorVersion>3.0.2</MediatorVersion>
        <MicrosoftExtensionsVersion>11.0.0</MicrosoftExtensionsVersion>
        <MicrosoftAiVersion>11.0.0</MicrosoftAiVersion>
        <MicrosoftTelemetryVersion>11.0.0</MicrosoftTelemetryVersion>
        <MicrosoftTestingVersion>11.0.0</MicrosoftTestingVersion>
        <OpenIddictVersion>7.9.0</OpenIddictVersion>
        <OtelVersion>1.21.0</OtelVersion>
        <OtelInstrVersion>1.21.0</OtelInstrVersion>
        <SkiaVersion>4.156.1</SkiaVersion>
        <TickerQVersion>11.5.1</TickerQVersion>
        <TUnitVersion>1.85.0</TUnitVersion>
    </PropertyGroup>
    <ItemGroup>
        <PackageVersion Include="AspNetCore.Authentication.Basic" Version="9.0.0"/>
        <PackageVersion Include="AspNetCore.Authentication.ApiKey" Version="9.0.0"/>
        <PackageVersion Include="TickerQ" Version="$(TickerQVersion)"/>
        <PackageVersion Include="TickerQ.Instrumentation.OpenTelemetry" Version="$(TickerQVersion)"/>
        <PackageVersion Include="TickerQ.MongoDB" Version="$(TickerQVersion)" />
        <PackageVersion Include="Kot.MongoDB.Migrations.DI" Version="3.1.0"/>
        <PackageVersion Include="Lib.Net.Http.WebPush" Version="3.3.1"/>
        <PackageVersion Include="MongoDB.Driver" Version="3.14.0"/>
        <PackageVersion Include="OpenIddict.AspNetCore" Version="$(OpenIddictVersion)"/>
        <PackageVersion Include="OpenIddict.MongoDb" Version="$(OpenIddictVersion)"/>
        <PackageVersion Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="$(MicrosoftExtensionsVersion)"/>
        <PackageVersion Include="System.Numerics.Tensors" Version="$(MicrosoftExtensionsVersion)"/>
        <PackageVersion Include="System.Security.Cryptography.Pkcs" Version="$(MicrosoftExtensionsVersion)"/>
        <PackageVersion Include="System.Security.Cryptography.Xml" Version="$(MicrosoftExtensionsVersion)"/>
        <PackageVersion Include="DotNext.Threading" Version="6.12.1"/>
        <PackageVersion Include="GrammarSharp.Russian" Version="0.3.0"/>
        <PackageVersion Include="Mediator.Abstractions" Version="$(MediatorVersion)"/>
        <PackageVersion Include="Mediator.SourceGenerator" Version="$(MediatorVersion)"/>
        <PackageVersion Include="Microsoft.AspNetCore.OpenApi" Version="$(MicrosoftExtensionsVersion)"/>
        <PackageVersion Include="Microsoft.Extensions.ApiDescription.Server" Version="$(MicrosoftExtensionsVersion)"/>
        <PackageVersion Include="Microsoft.Extensions.AI.Abstractions" Version="$(MicrosoftAiVersion)"/>
        <PackageVersion Include="Microsoft.Extensions.AI" Version="$(MicrosoftAiVersion)"/>
        <PackageVersion Include="Microsoft.Extensions.AI.OpenAI" Version="$(MicrosoftAiVersion)"/>
        <PackageVersion Include="Microsoft.Extensions.VectorData.Abstractions" Version="$(MicrosoftAiVersion)"/>
        <PackageVersion Include="CommunityToolkit.VectorData.InMemory" Version="1.0.1"/>
        <PackageVersion Include="Microsoft.ML.Tokenizers" Version="3.0.0"/>
        <PackageVersion Include="Microsoft.ML.OnnxRuntime" Version="1.32.0"/>
        <PackageVersion Include="Microsoft.Extensions.Compliance.Redaction" Version="$(MicrosoftTelemetryVersion)"/>
        <PackageVersion Include="Microsoft.Extensions.Http.Diagnostics" Version="$(MicrosoftTelemetryVersion)"/>
        <PackageVersion Include="Microsoft.Extensions.Telemetry.Abstractions" Version="$(MicrosoftTelemetryVersion)"/>
        <PackageVersion Include="Microsoft.Extensions.Configuration.Binder" Version="$(MicrosoftExtensionsVersion)"/>
        <PackageVersion Include="Microsoft.Extensions.Caching.Memory" Version="$(MicrosoftExtensionsVersion)"/>
        <PackageVersion Include="Riok.Mapperly" Version="4.3.1"/>
        <PackageVersion Include="Serilog.AspNetCore" Version="10.0.0"/>
        <PackageVersion Include="SkiaSharp" Version="$(SkiaVersion)"/>
        <PackageVersion Include="SkiaSharp.NativeAssets.Linux.NoDependencies" Version="$(SkiaVersion)"/>
        <PackageVersion Include="Swashbuckle.AspNetCore.SwaggerUI" Version="11.0.1"/>
        <PackageVersion Include="TgMiniAppAuth" Version="0.0.8"/>
        <PackageVersion Include="WebApiClientCore" Version="2.1.6"/>
        <PackageVersion Include="Microsoft.Extensions.Http.Resilience" Version="$(MicrosoftTelemetryVersion)"/>
        <PackageVersion Include="Telegram.Bot" Version="22.10.4"/>
        <PackageVersion Include="Vogen" Version="8.0.7"/>
        <PackageVersion Include="Microsoft.AspNetCore.WebUtilities" Version="$(MicrosoftExtensionsVersion)"/>
        <!--OpenTelemetry-->
        <PackageVersion Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="$(OtelVersion)"/>
        <PackageVersion Include="OpenTelemetry.Extensions.Hosting" Version="$(OtelVersion)"/>
        <PackageVersion Include="OpenTelemetry.Instrumentation.AspNetCore" Version="$(OtelInstrVersion)"/>
        <PackageVersion Include="OpenTelemetry.Instrumentation.Http" Version="$(OtelInstrVersion)"/>
        <PackageVersion Include="OpenTelemetry.Instrumentation.Runtime" Version="$(OtelInstrVersion)"/>
        <!--Analyzers-->
        <PackageVersion Include="CSharpGuidelinesAnalyzer" Version="3.8.5"/>
        <PackageVersion Include="Microsoft.VisualStudio.Threading.Analyzers" Version="18.12.1"/>
        <PackageVersion Include="Microsoft.CodeAnalysis.BannedApiAnalyzers" Version="5.6.0"/>
        <PackageVersion Include="MongoDB.Analyzer" Version="2.0.0"/>
        <PackageVersion Include="Nullable.Extended.Analyzer" Version="1.19.0"/>
        <PackageVersion Include="SonarAnalyzer.CSharp" Version="10.36.0.15337"/>
        <PackageVersion Include="StyleCop.Analyzers" Version="1.3.180"/>
        <!--Testing-->
        <PackageVersion Include="Humanizer" Version="3.0.10"/>
        <PackageVersion Include="Microsoft.Extensions.Diagnostics.Testing" Version="$(MicrosoftTestingVersion)"/>
        <PackageVersion Include="Microsoft.Extensions.TimeProvider.Testing" Version="$(MicrosoftTestingVersion)"/>
        <PackageVersion Include="NSubstitute" Version="6.2.0"/>
        <PackageVersion Include="Testcontainers" Version="4.16.0"/>
        <PackageVersion Include="TUnit" Version="$(TUnitVersion)"/>
        <PackageVersion Include="TUnit.AspNetCore" Version="$(TUnitVersion)"/>
        <PackageVersion Include="WireMock.Net.Minimal" Version="2.31.0"/>
        <PackageVersion Include="WebMotions.Fake.Authentication.JwtBearer" Version="10.0.0"/>
    </ItemGroup>
</Project>
