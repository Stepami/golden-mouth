<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Reki.Api\Reki.Api.csproj" />
    <ProjectReference Include="..\..\src\Reki.Contracts\Reki.Contracts.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="TUnit" />
    <PackageReference Include="TUnit.AspNetCore" />
  </ItemGroup>

  <Target Name="GenerateApiClient" BeforeTargets="CoreCompile">
    <Exec WorkingDirectory="$(MSBuildProjectDirectory)\..\..\src\Reki.Api"
          Command="dotnet tool run nswag run nswag.json /variables:Configuration=$(Configuration)" />
  </Target>
</Project>
